{
  "name": "business-tycoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "vite-node src/engine/bots/simulate.ts",
    "simulate:instant": "vite-node src/engine/bots/simulate-instant.ts",
    "analyze": "vite build --mode analyze"
  },
  "dependencies": {
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@tailwindcss/vite": "^4.1.17",
    "framer-motion": "^12.23.24",
    "howler": "^2.2.4",
    "i18next": "^25.6.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.4",
    "react-router-dom": "^7.9.5",
    "tailwindcss": "^4.1.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.23.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.4"
  }
}
